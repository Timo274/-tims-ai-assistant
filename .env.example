# =============================================================================
# tims-ai-assistant — example environment file. Copy to `.env` and fill in.
# =============================================================================

# --- Telegram --------------------------------------------------------------
# Get from @BotFather. Looks like 12345678:AAH....
BOT_TOKEN=

# Numeric Telegram user IDs allowed to use admin commands (comma-separated).
# Find yours by sending /start to @userinfobot.
ADMIN_IDS=

# Bot persona name shown to itself in prompts (does not affect Telegram name).
BOT_PERSONA_NAME=tim

# --- LLM provider (OpenAI-compatible) ---------------------------------------
# Any provider that exposes an OpenAI-compatible /v1/chat/completions endpoint.
#
# Examples:
#   OpenAI       LLM_BASE_URL=https://api.openai.com/v1               LLM_MODEL=gpt-4o-mini
#   DeepSeek     LLM_BASE_URL=https://api.deepseek.com/v1             LLM_MODEL=deepseek-chat
#   Groq         LLM_BASE_URL=https://api.groq.com/openai/v1          LLM_MODEL=llama-3.3-70b-versatile
#   OpenRouter   LLM_BASE_URL=https://openrouter.ai/api/v1            LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
#   Together     LLM_BASE_URL=https://api.together.xyz/v1             LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Model used for cheap background work (memory extraction, summarisation).
# Leave equal to LLM_MODEL if your provider only has one model.
LLM_SUMMARY_MODEL=gpt-4o-mini

LLM_TEMPERATURE=0.95
LLM_TOP_P=0.95
LLM_MAX_TOKENS=400
LLM_REQUEST_TIMEOUT=45

# --- Storage ---------------------------------------------------------------
# SQLite (default) — single-file, no setup. Use absolute path in production.
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://bot:bot@localhost:5432/timsbot

# --- Reply behaviour --------------------------------------------------------
# Debounce window: collect rapid messages from the same user, reply once.
REPLY_DEBOUNCE_SECONDS=2.5
# Per-character base delay used to simulate typing.
TYPING_DELAY_PER_CHAR=0.03
TYPING_DELAY_MIN=0.6
TYPING_DELAY_MAX=4.5
# How many recent messages to keep verbatim in the context window.
CONTEXT_RECENT_MESSAGES=20
# When raw history exceeds this many messages, summarise the oldest half.
SUMMARISE_AFTER_MESSAGES=40
# How many memory snippets to retrieve per reply.
MEMORY_TOP_K=8

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW_SECONDS=60

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=./logs

# --- Operational toggles ---------------------------------------------------
# When true, the bot starts paused and only admins can wake it via /resume.
START_PAUSED=false
# Reply to messages from groups too. Default: only direct messages.
REPLY_IN_GROUPS=false
